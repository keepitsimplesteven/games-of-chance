{
  "name": "@games-of-chance/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/room.ts",
  "scripts": {
    "build": "tsc --build",
    "dev": "npx wrangler dev --config ../../wrangler.jsonc --port 1999",
    "deploy": "npx wrangler deploy --config ../../wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "drive:cli": "npx tsx src/games/playcaller/drive/cli.ts"
  },
  "dependencies": {
    "@games-of-chance/shared": "workspace:*",
    "@games-of-chance/simulation": "workspace:*",
    "partyserver": "^0.5.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "fast-check": "^3.23.2",
    "typescript": "^5.4.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.0.0"
  }
}
