# PartyKit host for the client WebSocket connection (matches domain in partykit.deploy.json)
# Only needed for local deploys — CI uses GitHub Secrets instead
PARTYKIT_HOST=play.yourdomain.com

# Cloudflare credentials — only needed for local deploys
# In CI, these are stored as GitHub Secrets (see .github/workflows/deploy.yml)
# Get Account ID from: Cloudflare Dashboard → Overview sidebar
# Create API Token at: https://dash.cloudflare.com/profile/api-tokens
#   Use the "Edit Cloudflare Workers" template
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
